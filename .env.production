# ═══════════════════════════════════════════════════════════════════════════
# NexusBI Production Environment Configuration
# Copy to .env and fill in real values before deployment
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────
ENV=production
DEBUG=false
APP_NAME=NexusBI
APP_VERSION=1.0.0

# ── Security (GENERATE REAL VALUES) ───────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=RS256

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com"]

# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexusbi_metadata
POSTGRES_USER=nexusbi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── LLM Provider ──────────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
# ANTHROPIC_API_KEY=sk-ant-...  (if using Anthropic)

# ── LLM Guardrails ────────────────────────────────────────────────────
LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
LLM_FALLBACK_MODEL=gpt-4o
LLM_REQUEST_TIMEOUT=15
LLM_MAX_RETRIES=2

# ── Agent Guardrails ──────────────────────────────────────────────────
ENABLE_AGENTS=true
AGENT_MAX_COST_PER_RUN_USD=0.50
AGENT_MAX_DAILY_COST_PER_USER_USD=10.00

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_CHAT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_AGENT_REQUESTS_PER_MINUTE=10

# ── Query Guardrails ──────────────────────────────────────────────────
MAX_QUERY_ROW_LIMIT=50000
MAX_QUERY_TIMEOUT_SECONDS=30

# ── Feature Flags ─────────────────────────────────────────────────────
ENABLE_SEMANTIC_CACHE=false
ENABLE_FORECASTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_REQUEST_LOGGING=true
